{
  "manifest_version": 3,
  "name": "Job Post Finder – for professional networks",
  "version": "1.11.0",
  "description": "Scans the LinkedIn feed and post search results, detects job posts and saves them to a local table.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "unlimitedStorage", "activeTab"],
  "host_permissions": ["https://www.linkedin.com/*", "https://api.groq.com/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Job Post Finder – for professional networks",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["clipboard-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.linkedin.com/feed/*", "https://www.linkedin.com/search/results/content/*"],
      "js": ["location-dictionary.js", "shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
